#!/usr/bin/env python3
"""
HarmonyOS Code Graph - Indexer Script
用于初始化构建代码图索引
"""
import sys
import os
import argparse

# 路径设置同 code_graph
bin_dir = os.path.dirname(os.path.abspath(__file__))
lib_dir = os.path.join(os.path.dirname(bin_dir), 'lib')
sys.path.insert(0, lib_dir)

from core import CodeGraphAgent


def main():
    parser = argparse.ArgumentParser(
        description="Build code graph index for a repository"
    )
    parser.add_argument(
        "repo_path",
        nargs="?",
        default=os.getcwd(),
        help="Path to the repository root (default: current directory)"
    )
    parser.add_argument(
        "--force-clean",
        action="store_true",
        help="Clean the database before indexing"
    )
    parser.add_argument(
        "--project-id",
        type=str,
        default=None,
        help="Project ID (default: auto-generated from repo path)"
    )

    args = parser.parse_args()

    repo_path = os.path.abspath(args.repo_path)

    if not os.path.isdir(repo_path):
        print(f"Error: {repo_path} is not a valid directory", file=sys.stderr)
        sys.exit(1)

    # Generate project_id if not provided
    if args.project_id:
        project_id = args.project_id
    else:
        import hashlib
        canonical = str(repo_path)
        project_id = hashlib.sha256(canonical.encode()).hexdigest()[:16]

    print(f"Initializing graph index for: {repo_path}")
    print(f"Project ID: {project_id}")

    agent = CodeGraphAgent()
    try:
        # 构建索引
        agent.index_project(repo_path, project_id=project_id, force_clean=args.force_clean)
        print("✓ Graph indexing completed successfully.")
    except Exception as e:
        print(f"✗ Indexing failed: {e}", file=sys.stderr)
        import traceback
        traceback.print_exc()
        sys.exit(1)
    finally:
        agent.close()


if __name__ == "__main__":
    main()
